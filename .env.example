# Copy to .env (gitignored) and fill in. Everything has a local fallback if left empty.

# Tiger Data (Tiger Cloud Postgres / TimescaleDB) — lineage ledger. Empty → local SQLite.
# Tiger Cloud console → your service → Connect → "Connection string" (postgres://...?sslmode=require)
LETHE_DATABASE_URL=

# Sentry — tracing of the revocation pipeline + Cron Monitor for the deletion SLA. Empty → disabled.
# Sentry → Settings → Projects → <project> → Client Keys (DSN)
SENTRY_DSN=

# Google Gemini — realistic synthetic tenant data + plain-English certificate summaries. Empty → templates.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- tabular patient path (python -m lethe.tabular) ----
# Tiger Data connection string for the PATIENT table (falls back to LETHE_DATABASE_URL)
LETHE_PATIENTS_URL=
# Snowflake (only if you seed with --to snowflake; needs `uv sync --extra snowflake`)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=

# Gemma on the Arduino UNO Q (llama.cpp OpenAI-compatible endpoint). Empty -> offline rule parser.
GEMMA_URL=
GEMMA_MODEL=gemma-3-1b-it
GEMMA_TIMEOUT=30

# Sentry AI view: also send prompt/response text (demo data is synthetic)
LETHE_SENTRY_PROMPTS=1
