# Copy to .env (gitignored) and fill in. Everything has a local fallback if left empty.

# Tiger Data (Tiger Cloud Postgres / TimescaleDB) — lineage ledger. Empty → local SQLite.
# Tiger Cloud console → your service → Connect → "Connection string" (postgres://...?sslmode=require)
LETHE_DATABASE_URL=

# Sentry — tracing of the revocation pipeline + Cron Monitor for the deletion SLA. Empty → disabled.
# Sentry → Settings → Projects → <project> → Client Keys (DSN)
SENTRY_DSN=

# Google Gemini — realistic synthetic tenant data + plain-English certificate summaries. Empty → templates.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
